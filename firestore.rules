rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function ownsActivity(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validGameActivity(data) {
      return data.keys().hasOnly([
          'type', 'game', 'outcome', 'difficulty', 'startedAtMs',
          'finishedAtMs', 'durationMs', 'durationSeconds', 'details', 'updatedAt'
        ])
        && data.game in ['tic-tac-toe', 'memory', 'quick-math']
        && data.outcome in ['in-progress', 'win', 'loss', 'draw', 'completed', 'abandoned']
        && data.startedAtMs is int
        && data.durationMs is int
        && data.durationSeconds is int
        && data.details is map
        && (
          (data.game == 'tic-tac-toe'
            && data.difficulty in ['low', 'mid', 'high', 'extreme']
            && data.details.keys().hasOnly(['moves']))
          || (data.game == 'memory'
            && data.details.keys().hasOnly(['pairsFound', 'attempts', 'flips', 'moves']))
          || (data.game == 'quick-math'
            && data.details.keys().hasOnly(['questionsAnswered', 'correct', 'incorrect', 'rounds']))
        );
    }

    function validChatActivity(data) {
      return data.keys().hasOnly([
          'type', 'conversationId', 'conversationIds', 'startedAtMs',
          'durationMs', 'durationSeconds', 'messagesSent', 'messagesAnswered',
          'messagesFailed', 'updatedAt'
        ])
        && data.startedAtMs is int
        && data.durationMs is int
        && data.durationSeconds is int
        && data.messagesSent is int
        && data.messagesAnswered is int
        && data.messagesFailed is int
        && data.conversationIds is list;
    }

    function validCoveredTopic(data) {
      return data.keys().hasOnly(['title', 'coveredAtMs'])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 100
        && data.coveredAtMs is int;
    }

    function validLeaderboardEntry(data) {
      return data.keys().hasOnly(['displayName', 'gameWins', 'topicCount'])
        && data.keys().hasAll(['displayName', 'gameWins', 'topicCount'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 80
        && data.gameWins is int
        && data.gameWins >= 0
        && data.gameWins <= 1000000
        && data.topicCount is int
        && data.topicCount >= 0
        && data.topicCount <= 1000000;
    }

    match /users/{userId}/activity/{activityId} {
      allow read, delete: if ownsActivity(userId);
      allow create, update: if ownsActivity(userId)
        && request.resource.data.type in ['game', 'chat']
        && (
          (request.resource.data.type == 'game' && validGameActivity(request.resource.data))
          || (request.resource.data.type == 'chat' && validChatActivity(request.resource.data))
        );
    }

    match /users/{userId}/topics/{topicId} {
      allow read, delete: if ownsActivity(userId);
      allow create, update: if ownsActivity(userId)
        && validCoveredTopic(request.resource.data);
    }

    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow create, update: if ownsActivity(userId)
        && validLeaderboardEntry(request.resource.data);
      allow delete: if ownsActivity(userId);
    }
  }
}
